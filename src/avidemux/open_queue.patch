+
+void GUI_OpenJobsQueue()
+{
+#if QT_VERSION >= QT_VERSION_CHECK(6,0,0)
+    const char *jobsBin = "avidemux3_jobs_qt6";
+#elif QT_VERSION >= QT_VERSION_CHECK(5,0,0)
+    const char *jobsBin = "avidemux3_jobs_qt5";
+#else
+    const char *jobsBin = "avidemux3_jobs_qt4";
+#endif
+    QString program = QCoreApplication::applicationDirPath() + QString("/") + QString(jobsBin);
+    if(!QProcess::startDetached(program))
+    {
+        // Fall back to PATH lookup.
+        if(!QProcess::startDetached(QString(jobsBin)))
+            ADM_error("Failed to start jobs manager (%s)\n", jobsBin);
+    }
+}
